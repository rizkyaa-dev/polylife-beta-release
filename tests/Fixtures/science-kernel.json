[
  {
    "name": "spring-equilibrium",
    "solver": "linear_system",
    "inputs": {"matrix": [[400,-100,0],[-100,300,-100],[0,-100,200]], "rhs": [10,0,5]},
    "expected": {"status":"computed", "solution":[0.030555555555555555,0.022222222222222223,0.036111111111111115]}
  },
  {
    "name": "mesh-circuit",
    "solver": "linear_system",
    "inputs": {"matrix": [[12,-4,-2],[-4,15,-3],[-2,-3,10]], "rhs": [24,-6,12]},
    "expected": {"status":"computed", "solution":[2.5365168539325844,0.6573033707865169,1.904494382022472]}
  },
  {
    "name":"unit-converted-linear-current",
    "solver":"linear_system",
    "inputs":{"matrix":[[2000]],"rhs":[10],
      "dimensions":{"variables":[[0,0,0,1,0,0,0]],"rhs":[[1,2,-3,-1,0,0,0]],"matrix":[[[1,2,-3,-2,0,0,0]]]},
      "conversions":[{"path":["matrix",0,0],"source_value":2,"source_unit":"kohm"}]},
    "expected":{"status":"computed","solution":[0.005]}
  },
  {
    "name":"work-integral",
    "solver":"integrate",
    "inputs": {
      "lower":0,"upper":2,"tolerance":1e-7,
      "expression":{"op":"mul","args":[
        {"op":"mul","args":[{"op":"const","value":10,"dimension":[1,0,-2,0,0,0,0]},{"op":"var","name":"x"}]},
        {"op":"exp","args":[{"op":"mul","args":[{"op":"const","value":-1,"dimension":[0,-2,0,0,0,0,0]},{"op":"pow","args":[{"op":"var","name":"x"},{"op":"const","value":2}]}]}]}
      ]},
      "dimensions":{"x":[0,1,0,0,0,0,0],"output":[1,2,-2,0,0,0,0]}
    },
    "expected":{"status":"computed","value":4.908421805556329}
  },
  {
    "name":"unit-converted-work-integral",
    "solver":"integrate",
    "inputs":{"lower":0,"upper":2,"expression":{"op":"const","value":10,"dimension":[1,1,-2,0,0,0,0]},
      "dimensions":{"x":[0,1,0,0,0,0,0],"output":[1,2,-2,0,0,0,0]},
      "conversions":[
        {"path":["lower"],"source_value":0,"source_unit":"cm"},
        {"path":["upper"],"source_value":200,"source_unit":"cm"},
        {"path":["expression","value"],"source_value":10,"source_unit":"N"}
      ]},
    "expected":{"status":"computed","value":20}
  },
  {
    "name":"exponential-decay",
    "solver":"ode_ivp",
    "inputs":{"initial":[2],"derivatives":[{"op":"mul","args":[{"op":"const","value":-0.5},{"op":"var","name":"y0"}]}],"t_start":0,"t_end":10,"tolerance":1e-8},
    "expected":{"status":"computed","final_state":[0.013475893998170934]}
  },
  {
    "name":"damped-oscillator",
    "solver":"ode_ivp",
    "inputs":{"initial":[1,0],"derivatives":[
      {"op":"var","name":"y1"},
      {"op":"sub","args":[{"op":"mul","args":[{"op":"const","value":-4},{"op":"var","name":"y0"}]},{"op":"mul","args":[{"op":"const","value":0.4},{"op":"var","name":"y1"}]}]}
    ],"t_start":0,"t_end":5,"tolerance":1e-8},
    "expected":{"status":"computed","final_state":[-0.33685168059041337,0.3706914139692117]}
  },
  {
    "name":"resonant-forcing",
    "solver":"ode_ivp",
    "inputs":{"initial":[0,0],"derivatives":[
      {"op":"var","name":"y1"},
      {"op":"sub","args":[
        {"op":"mul","args":[{"op":"const","value":3},{"op":"sin","args":[{"op":"mul","args":[{"op":"const","value":2},{"op":"var","name":"t"}]}]}]},
        {"op":"mul","args":[{"op":"const","value":4},{"op":"var","name":"y0"}]}
      ]}
    ],"t_start":0,"t_end":5,"tolerance":1e-8},
    "expected":{"status":"computed","final_state":[2.942510317453183,-4.080158331670273]}
  },
  {
    "name":"constant-rational-dimensional-root",
    "solver":"integrate",
    "inputs":{"expression":{"op":"pow","args":[
      {"op":"const","value":16,"dimension":[0,0,0,0,4,0,0]},
      {"op":"div","args":[{"op":"const","value":1},{"op":"const","value":4}]}
    ]},"lower":0,"upper":1,"dimensions":{"x":[0,0,0,0,0,0,0],"output":[0,0,0,0,1,0,0]}},
    "expected":{"status":"computed","value":2,"tolerance":1e-12}
  },
  {
    "name":"radiative-power-continuation",
    "solver":"ode_ivp",
    "inputs":{"initial":[300],"derivatives":[
      {"op":"div","args":[{"op":"const","value":1},{"op":"mul","args":[
        {"op":"const","value":1.81451981408e-9,"dimension":[1,2,-3,0,-4,0,0]},
        {"op":"pow","args":[{"op":"var","name":"y0"},{"op":"const","value":3}]}
      ]}]}
    ],"t_start":0,"t_end":40,"tolerance":1e-8,"dimensions":{"t":[1,2,-3,0,0,0,0],"states":[[0,0,0,0,1,0,0]]}},
    "expected":{"status":"computed","final_state":[557.0334974621942],"tolerance":1e-5}
  },
  {
    "name":"radiative-temperature-output",
    "solver":"linear_system",
    "inputs":{"matrix":[[1]],"rhs":[96277598700.47128],
      "dimensions":{"variables":[[0,0,0,0,4,0,0]],"rhs":[[0,0,0,0,4,0,0]],"matrix":[[[0,0,0,0,0,0,0]]]},
      "outputs":[{"name":"temperature","dimension":[0,0,0,0,1,0,0],"expression":{"op":"pow","args":[
        {"op":"var","name":"r0"},{"op":"div","args":[{"op":"const","value":1},{"op":"const","value":4}]}
      ]}}]},
    "expected":{"status":"computed","outputs":[557.0334974621942],"tolerance":1e-9}
  },
  {
    "name":"radiative-equilibrium-root",
    "solver":"root_scalar",
    "inputs":{"lower":300,"upper":1000,"tolerance":1e-8,
      "expression":{"op":"sub","args":[
        {"op":"mul","args":[
          {"op":"const","value":4.5362995352e-10,"dimension":[1,2,-3,0,-4,0,0]},
          {"op":"sub","args":[
            {"op":"pow","args":[{"op":"var","name":"x"},{"op":"const","value":4}]},
            {"op":"const","value":8100000000,"dimension":[0,0,0,0,4,0,0]}
          ]}
        ]},
        {"op":"const","value":40,"dimension":[1,2,-3,0,0,0,0]}
      ]},
      "dimensions":{"x":[0,0,0,0,1,0,0],"output":[1,2,-3,0,0,0,0]}},
    "expected":{"status":"computed","value":557.0334974621942,"tolerance":1e-7}
  },
  {
    "name":"celsius-bracket-root",
    "solver":"root_scalar",
    "inputs":{"lower":293.15,"upper":373.15,"tolerance":1e-10,
      "expression":{"op":"sub","args":[{"op":"var","name":"x"},{"op":"const","value":300,"dimension":[0,0,0,0,1,0,0]}]},
      "dimensions":{"x":[0,0,0,0,1,0,0],"output":[0,0,0,0,1,0,0]},
      "conversions":[
        {"path":["lower"],"source_value":20,"source_unit":"degC"},
        {"path":["upper"],"source_value":100,"source_unit":"degC"}
      ]},
    "expected":{"status":"computed","value":300,"tolerance":1e-9}
  },
  {
    "name":"singular-matrix",
    "solver":"linear_system",
    "inputs":{"matrix":[[1,2],[2,4]],"rhs":[3,6]},
    "expected":{"status":"not_solved"}
  },
  {
    "name":"stiff-ode-budget",
    "solver":"ode_ivp",
    "inputs":{"initial":[1],"derivatives":[{"op":"mul","args":[{"op":"const","value":-1000000},{"op":"var","name":"y0"}]}],"t_start":0,"t_end":1},
    "expected":{"status":"not_converged"}
  },
  {
    "name":"tiny-interval-large-integrand",
    "solver":"integrate",
    "inputs":{"expression":{"op":"const","value":1e308},"lower":0,"upper":1e-323},
    "expected":{"status":"computed","value":9.881312916824931e-16,"tolerance":1e-28}
  },
  {
    "name":"large-interval-subnormal-integrand",
    "solver":"integrate",
    "inputs":{"expression":{"op":"const","value":5e-324},"lower":0,"upper":1e308},
    "expected":{"status":"computed","value":4.9406564584124654e-16,"tolerance":1e-28}
  },
  {
    "name":"offset-time-sampling",
    "solver":"ode_ivp",
    "inputs":{"initial":[0],"derivatives":[{"op":"const","value":1}],"t_start":1000000000000,"t_end":1000000000001},
    "expected":{"status":"computed","final_state":[1]}
  }
]
